{
  "manifest_version": 3,
  "name": "Token Forwarder (GMGN + Moby)",
  "version": "1.2.0",
  "description": "Forwards new Solana tokens from the GMGN follow page and the Moby screener API to a local Telethon backend.",
  "permissions": [
    "storage",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://web-api.mobyscreener.com/*",
    "https://app.moby.win/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Token Forwarder"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://www.gmgn.ai/*"
      ],
      "js": [
        "common.js",
        "gmgn.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.moby.win/*"
      ],
      "js": [
        "moby-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://app.moby.win/*"
      ],
      "js": [
        "moby-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
