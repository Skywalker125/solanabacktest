# Get these at https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
# Telethon session file name (created on first login, keep it private)
TG_SESSION=forwarder

# Target channel per page: @username, t.me link, or numeric id (-100...)
GMGN_CHANNEL=@my_gmgn_channel
MOBY_CHANNEL=@my_moby_channel

# Local HTTP server the extension talks to
HOST=127.0.0.1
PORT=8765
# Optional shared secret; must match the "Secret" field in the extension popup
SHARED_SECRET=
